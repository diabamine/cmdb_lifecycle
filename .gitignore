# environment
.venv/
__pycache__/
*.pyc

# fetched or derived data: rebuilt by run_all.sh
raw/
out/
out2/
out_real/
out_real_before/
out_vendor/
reports/
*.log

# Large files: committed selectively (see OFFLINE_SETUP.md)
# snapshot/ is partially committed (reference data: endoflife, redhat, vendors, kev, epss)
# Excluded: nvd.sqlite (302MB) and nvd/ (staging files) - too large for git
snapshot/nvd.sqlite
snapshot/nvd/

# secrets (API keys)
.env

# eol.network data: its terms forbid republishing, and each API key gets watermark records. Keep local, never commit.
snapshot/eolnetwork/

# human review decisions can contain internal product names: commit deliberately, if at all
aliases.csv

# editor settings
.vscode/
